#!/bin/sh
set -e
if ! getent passwd conch >/dev/null 2>&1; then
  adduser --system --group --home /var/lib/conch --no-create-home --disabled-login conch
fi
install -d -o conch -g conch -m 0700 /var/lib/conch
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi
if command -v systemctl >/dev/null 2>&1; then
  systemctl enable --now conchd.service >/dev/null 2>&1 || true
fi
exit 0
